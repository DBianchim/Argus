# =============================================================================
# .env.example — template de configuração do Docker Compose da CENTRAL
#
# Copie para .env e preencha com valores FORTES e ÚNICOS por instalação:
#     cp .env.example .env        (Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# O arquivo .env real contém segredos e NÃO é versionado (ver .gitignore).
# Gere segredos fortes com, por exemplo:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# Senha do usuário do PostgreSQL (usuário e banco "argus" são fixos).
# Usada tanto pelo container do banco quanto na DATABASE_URL montada para a API.
POSTGRES_PASSWORD=TROQUE_por_uma_senha_forte

# Token único para os endpoints de consulta do dashboard (auth de serviço).
DASHBOARD_TOKEN=TROQUE_por_um_token_forte

# Hostname/IP usado para acessar a central na rede (o certificado HTTPS interno
# é emitido para este nome). Default: localhost. Defina com o nome de rede da
# central para acesso de outras máquinas — ex.: argus.empresa.local
# Acesse sempre pelo MESMO nome definido aqui (acesso por IP puro não envia SNI).
# ARGUS_HOST=argus.empresa.local

# ── Opção NUVEM (domínio público) ────────────────────────────────────────────
# Para publicar em um domínio real: defina ARGUS_HOST com o domínio e REMOVA a
# linha `tls internal` em docker/Caddyfile — o Caddy passa a emitir Let's Encrypt
# automaticamente (instruções no próprio Caddyfile).
# ARGUS_HOST=argus.suaempresa.com.br
