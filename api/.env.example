# Template de configuração da API Argus.
# Copie para .env e preencha. NUNCA coloque segredos reais neste .example.
#
#   cp .env.example .env
#
# Em produção, defina estas variáveis no ambiente (systemd/serviço), sem arquivo.

# Conexão PostgreSQL (driver async asyncpg)
DATABASE_URL=postgresql+asyncpg://argus:SUA_SENHA_AQUI@localhost:5432/argus

# Token único dos endpoints de consulta do dashboard
DASHBOARD_TOKEN=troque-por-um-token-forte

APP_ENV=dev
LOG_LEVEL=INFO
